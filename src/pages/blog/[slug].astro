---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }))
}

const { post, prev, next } = Astro.props
const { Content } = await render(post)

const fmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 200))
const hero = post.data.heroImage
// social cards can't use SVG; fall back to the default card
const ogImage = hero && hero.format !== 'svg' ? hero.src : undefined
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  article={{ published: post.data.pubDate }}
>
  <article class="container">
    <header class="page-top">
      <a href="/blog" class="small">← Blog</a>
      <h1 class="post-title">
        {post.data.title}
      </h1>
      <time class="meta" datetime={post.data.pubDate.toISOString()}>
        {fmt.format(post.data.pubDate)}
      </time>
      <span class="meta"> · {minutes} min read</span>
      {post.data.tags.length > 0 && (
        <div class="tag-row">
          {post.data.tags.map((t) => <a class="chip" href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>)}
        </div>
      )}
    </header>

    {
      post.data.heroImage && (
        <>
          <Image
            class="post-hero"
            src={post.data.heroImage}
            alt={post.data.heroImageAlt ?? ''}
            width={1920}
            height={768}
            loading="eager"
          />
          {post.data.heroImageCredit && (
            <p class="credit">
              Photo by{' '}
              <a href={post.data.heroImageCreditUrl} rel="noopener">
                {post.data.heroImageCredit}
              </a>{' '}
              on <a href="https://unsplash.com">Unsplash</a>
            </p>
          )}
        </>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <hr class="post-end" />
    <nav class="post-nav">
      {prev ? <a href={`/blog/${prev.id}/`}>← {prev.data.title}</a> : <span />}
      {next ? <a href={`/blog/${next.id}/`}>{next.data.title} →</a> : <span />}
    </nav>
  </article>
</Base>