---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }))
}

const { post, prev, next } = Astro.props
const { Content } = await render(post)

const fmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 200))
const hero = post.data.heroImage
// social cards can't use SVG; fall back to the default card
const ogImage = hero && hero.format !== 'svg' ? hero.src : undefined
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  article={{ published: post.data.pubDate }}
>
  <article class="container">
    <header style="padding-top: 3rem">
      <a href="/blog" style="font-size: 0.9rem">← Blog</a>
      <h1 style="font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0.75rem 0 0.5rem">
        {post.data.title}
      </h1>
      <time
        datetime={post.data.pubDate.toISOString()}
        style="color: var(--muted); font-size: 0.95rem"
      >
        {fmt.format(post.data.pubDate)}
      </time>
      <span style="color: var(--muted); font-size: 0.95rem"> · {minutes} min read</span>
      {post.data.tags.length > 0 && (
        <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem; flex-wrap: wrap">
          {post.data.tags.map((t) => <span class="chip">{t}</span>)}
        </div>
      )}
    </header>

    {
      post.data.heroImage && (
        <>
          <Image
            class="post-hero"
            src={post.data.heroImage}
            alt={post.data.heroImageAlt ?? ''}
            width={1920}
            height={960}
            loading="eager"
          />
          {post.data.heroImageCredit && (
            <p class="credit">
              Photo by{' '}
              <a href={post.data.heroImageCreditUrl} rel="noopener">
                {post.data.heroImageCredit}
              </a>{' '}
              on <a href="https://unsplash.com">Unsplash</a>
            </p>
          )}
        </>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <hr style="margin: 3rem 0 2rem; border: none; border-top: 1px solid var(--border)" />
    <nav class="post-nav">
      {prev ? <a href={`/blog/${prev.id}/`}>← {prev.data.title}</a> : <span />}
      {next ? <a href={`/blog/${next.id}/`}>{next.data.title} →</a> : <span />}
    </nav>
  </article>
</Base>