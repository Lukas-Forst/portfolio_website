---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const fmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
})
---

<Base title="Blog" description="Data science, analytics, and building things — posts by Lukas Forst.">
  <section class="container" style="padding-top: 3rem">
    <h1 style="font-size: 2rem; margin-bottom: 0.5rem">Blog</h1>
    <p style="color: var(--muted); margin-top: 0">
      Notes on data projects, learning, and building things.
    </p>
    <div style="margin-top: 2rem">
      {posts.map((post) => (
        <div class="post-item">
          <time datetime={post.data.pubDate.toISOString()}>
            {fmt.format(post.data.pubDate)}
          </time>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        </div>
      ))}
    </div>
  </section>
</Base>