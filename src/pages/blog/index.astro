---
import Base from '../../layouts/Base.astro'
import PostList from '../../components/PostList.astro'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort()
---

<Base title="Blog" description="Data science, analytics, and building things — posts by Lukas Forst.">
  <section class="container page-top">
    <h1 class="page-title">Blog</h1>
    <p class="muted">Notes on data projects, learning, and building things.</p>
    <div class="tag-row">
      {tags.map((t) => <a class="chip" href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>)}
    </div>
    <div class="list-gap"><PostList posts={posts} describe /></div>
  </section>
</Base>
